<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
	<Controls>
		<Control>
			<Name>Index-GroupingFormat</Name>
			<CustomControl>
				<CustomEntries>
					<CustomEntry>
						<CustomItem>
							<Frame>
								<LeftIndent>4</LeftIndent>
								<CustomItem>
									<Text>SQL Instance Name : </Text>
									<ExpressionBinding>
										<PropertyName>SqlInstanceName</PropertyName>
									</ExpressionBinding>
								</CustomItem>
							</Frame>
							<NewLine/>
							<Frame>
								<LeftIndent>4</LeftIndent>
								<CustomItem>
									<Text>Database Name     : </Text>
									<ExpressionBinding>
										<PropertyName>DatabaseName</PropertyName>
									</ExpressionBinding>
								</CustomItem>
							</Frame>
						</CustomItem>
					</CustomEntry>
				</CustomEntries>
			</CustomControl>
		</Control>
		<Control>
			<Name>Statistics-GroupingFormat</Name>
			<CustomControl>
				<CustomEntries>
					<CustomEntry>
						<CustomItem>
							<Frame>
								<LeftIndent>4</LeftIndent>
								<CustomItem>
									<Text>Database Name      : </Text>
									<ExpressionBinding>
										<PropertyName>DatabaseName</PropertyName>
									</ExpressionBinding>
								</CustomItem>
							</Frame>
							<NewLine/>
							<Frame>
								<LeftIndent>4</LeftIndent>
								<CustomItem>
									<Text>Statistics Options : </Text>
									<ExpressionBinding>
										<ScriptBlock>
											if ($_.StatisticsOptions) {
												$_.StatisticsOptions
											}
											else {
												'None'
											}
										</ScriptBlock>
									</ExpressionBinding>
								</CustomItem>
							</Frame>
							<NewLine/>
						</CustomItem>
					</CustomEntry>
				</CustomEntries>
			</CustomControl>
		</Control>
	</Controls>
	<ViewDefinitions>
		<View>
			<Name>CheckDb</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.CheckDb</TypeName>
			</ViewSelectedBy>
			<GroupBy>
				<Label>Database Name</Label>
				<PropertyName>DatabaseName</PropertyName>
			</GroupBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Error</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Level</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>State</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Message</Label>
						<Width>96</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<Wrap />
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>Error</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Level</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>State</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>MessageText</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>CheckDbResult</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.CheckDbResult</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Database Name</Label>
						<Width>32</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Is No Index</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>CheckDBOptions</Label>
						<Width>32</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>CheckDb Status</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<Wrap />
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>DatabaseName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>IsNoIndex</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>CheckDBOptions</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<Alignment>left</Alignment>
								<ScriptBlock>
									$Status = $_.CheckDbStatus

									$FormatString = "$([char]27)[{0}m{1}$([char]27)[0m"

									switch ($Status) {
										'S' {
											$Color = 32
											$Output = 'Success'
										}
										'F' {
											$Color = 31
											$Output = 'Failure'
										}
										'W' {
											$Color = 33
											$Output = 'Warning'
										}
										Default {
											$Color = 39
											$Output = 'Unknown'
										}
									}

									[string]::Format($FormatString, $Color, $Output)
								</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
