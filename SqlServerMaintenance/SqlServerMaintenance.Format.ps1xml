		<View>
			<Name>SqlServerMaintenanceBackup</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.Backup</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Database Name</Label>
						<Width>48</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Pages</Label>
						<Width>16</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Seconds</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>MB/sec</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>DatabaseName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Pages</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>Seconds</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>MBPerSecond</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>TableStatistics_Table</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.TableStatistics</TypeName>
			</ViewSelectedBy>
			<GroupBy>
				<CustomControlName>Statistics-GroupingFormat</CustomControlName>
				<ScriptBlock>$($_.DatabaseName + '&amp;' + $_.StatisticsOptions)</ScriptBlock>
			</GroupBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Schema Name</Label>
						<Width>16</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Object Name</Label>
						<Width>28</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Statistics Name</Label>
						<Width>28</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Rows</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Modified</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Method</Label>
						<Width>8</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Row Threshold</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Modification Threshold</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<Wrap />
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>SchemaName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ObjectName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>StatisticsName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>RowCount</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ModificationCount</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>
									switch ($_.Method) {
										'StaticThreshold' {
											'Static'
										}
										'DynamicThreshold' {
											'Dynamic'
										}
										'None' {
											'None'
										}
										'NullModificationCount' {
											'Null'
										}
									}
								</ScriptBlock>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>RowCountThreshold</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>ModificationCountThreshold</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>TableStatistics_Table</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.TableStatistics</TypeName>
			</ViewSelectedBy>
			<ListControl>
				<!-- ################ LIST DEFINITIONS ################ -->
				<ListEntries>
					<ListEntry>
						<ListItems>
							<ListItem>
								<Label>Database Name</Label>
								<PropertyName>DatabaseName</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Schema Name</Label>
								<PropertyName>SchemaName</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Object Name</Label>
								<PropertyName>ObjectName</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Statistics Name</Label>
								<PropertyName>StatisticsName</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Row Count</Label>
								<PropertyName>RowCount</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Modification Count</Label>
								<PropertyName>ModificationCount</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Method</Label>
								<PropertyName>Method</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Row Count Threshold</Label>
								<PropertyName>RowCountThreshold</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Modification Count Threshold</Label>
								<PropertyName>ModificationCountThreshold</PropertyName>
							</ListItem>
							<ListItem>
								<Label>Statistics Options</Label>
								<ScriptBlock>
									if ($_.StatisticsOptions) {
										$_.StatisticsOptions
									}
									else {
										'None'
									}
								</ScriptBlock>
							</ListItem>
						</ListItems>
					</ListEntry>
				</ListEntries>
			</ListControl>
		</View>
		<View>
			<Name>TransparentDataEncryptionStatus</Name>
			<ViewSelectedBy>
				<TypeName>SqlServerMaintenance.TransparentDataEncryptionStatus</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Database Name</Label>
						<Width>32</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Encryption State</Label>
						<Width>36</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Percent Complete</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Key Algorithm</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Key Length</Label>
						<Width>10</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Encryptor Type</Label>
						<Width>16</Width>
						<Alignment>left</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>DatabaseName</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>EncryptionState</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>PercentComplete</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>KeyAlgorithm</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>KeyLength</PropertyName>
								<Alignment>right</Alignment>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>EncryptorType</PropertyName>
								<Alignment>left</Alignment>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
	</ViewDefinitions>
</Configuration>

